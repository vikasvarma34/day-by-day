{
  "name": "day-by-day-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test:clean-users": "ALLOW_AUTOMATED_TEST_USER_CLEANUP=true tsx --env-file=.env scripts/clean-test-users.ts",
    "test": "tsx --test \"src/**/*.test.ts\" \"tests/unit/**/*.test.ts\" && npm run test:integration && npm run test:e2e",
    "test:unit": "tsx --test \"src/**/*.test.ts\" \"tests/unit/**/*.test.ts\"",
    "test:integration": "ALLOW_AUTOMATED_TEST_USER_CLEANUP=true tsx --env-file=.env scripts/clean-test-users.ts && tsx --env-file=.env --test \"tests/integration/**/*.test.ts\"",
    "test:e2e": "ALLOW_AUTOMATED_TEST_USER_CLEANUP=true tsx --env-file=.env scripts/clean-test-users.ts && tsx --env-file=.env --test \"tests/e2e/**/*.test.ts\"",
    "dev": "tsx --env-file=.env src/server.ts",
    "db:check": "tsx --env-file=.env scripts/check-db.ts",
    "db:reset:dev": "tsx --env-file=.env scripts/reset-dev-db.ts",
    "user:create": "tsx --env-file=.env scripts/create-user.ts",
    "user:seed:dev": "tsx --env-file=.env scripts/seed-dev-user.ts",
    "smoke:api": "tsx --env-file=.env scripts/smoke-api.ts",
    "migrate": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate up --migrations-dir migrations --database-url-var MIGRATION_DATABASE_URL",
    "migrate:create": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate create --migrations-dir migrations --migration-file-language sql"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.3",
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
