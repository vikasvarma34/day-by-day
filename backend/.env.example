# PostgreSQL Connections
DATABASE_URL=postgresql://user:password@localhost:5432/daybyday
MIGRATION_DATABASE_URL=postgresql://user:password@localhost:5432/daybyday

# Runtime Environment (development | test | production)
NODE_ENV=development

# Logging Level (debug | info | warn | error) - optional, defaults by NODE_ENV
# LOG_LEVEL=debug

# Persistent Local Development / Smoke Test User
TEST_USER_EMAIL=example@gmail.com
TEST_USER_PASSWORD=examplePassword

# Destructive Development Database Reset Guard
# WARNING: Setting ALLOW_DEV_DB_RESET=true permits npm run db:reset:dev to purge application data.
ALLOW_DEV_DB_RESET=false
